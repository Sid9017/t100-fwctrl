@import "../../pages/shared/device.wxss";
.add-method-sheet,.scanner-sheet { animation:sheet-enter 220ms cubic-bezier(.22,.68,0,1); }
.scanner-mask { animation:mask-enter 180ms ease-out; }
@keyframes sheet-enter { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes mask-enter { from { opacity:0; } to { opacity:1; } }
@media(prefers-reduced-motion:reduce){.add-method-sheet,.scanner-sheet,.scanner-mask { animation:none; }}
