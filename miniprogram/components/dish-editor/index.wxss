@import "../../pages/dish/index.wxss";
.dish-overlay { position:fixed;inset:0;z-index:80; }
.dish-mask { position:absolute;inset:0;background:rgba(36,43,30,.18); }
.dish-sheet { position:absolute;left:0;right:0;bottom:0;max-width:540px;margin:0 auto;height:auto;max-height:90%;border-radius:36rpx 36rpx 0 0;background:linear-gradient(180deg,#fff 0%,#f6faec 100%);display:flex;flex-direction:column;box-shadow:0 -8rpx 36rpx #3535350a; }
.sheet-handle { flex:none;width:64rpx;height:7rpx;margin:16rpx auto 0;border-radius:99rpx;background:#d9ddcf; }
.dish-sheet-scroll { flex:0 1 auto;min-height:0;height:auto;max-height:calc(90vh - 23rpx); }
.dish-body { padding:12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.dish-header { margin:0 0 24rpx; }
.dish-header .title { font-size:44rpx; }
.dish-photo-row { margin-bottom:24rpx; }
.dish-container-card { margin:0;padding:20rpx 12rpx; }
.entering .dish-sheet { animation:dish-sheet-in 320ms cubic-bezier(.22,.68,0,1) both;pointer-events:none; }
.entering .dish-mask { animation:dish-mask-in 320ms ease both; }
.closing { pointer-events:none; }
.closing .dish-sheet { animation:dish-sheet-out 240ms cubic-bezier(.4,0,1,1) both; }
.closing .dish-mask { animation:dish-mask-out 240ms ease both; }
@keyframes dish-sheet-in { from { transform:translateY(100%); } to { transform:none; } }
@keyframes dish-sheet-out { from { transform:none; } to { transform:translateY(100%); } }
@keyframes dish-mask-in { from { opacity:0; } to { opacity:1; } }
@keyframes dish-mask-out { from { opacity:1; } to { opacity:0; } }
@media(prefers-reduced-motion:reduce){.dish-sheet,.dish-mask { animation-duration:1ms !important; }}
