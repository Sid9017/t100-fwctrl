<view class="nutrition-layout" wx:if="{{selected}}">
  <view class="rings" id="rings" catchtouchstart="ringTouchStart" catchtouchmove="ringTouchMove" catchtouchend="ringTouchEnd" catchtouchcancel="ringTouchEnd">
    <button wx:for="{{rings}}" wx:key="key" class="ring-control {{selectedKey === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" catchtap="selectRing" hover-class="none" aria-label="{{item.name+', '+item.total+' grams recorded'+(item.goal === null ? '' : ', daily target '+item.goal+' grams')+(item.partial ? ', partial data' : '')}}" aria-pressed="{{selectedKey === item.key}}"><image class="ring-image" src="{{item.source}}" aria-hidden="true"/></button>
  </view>
  <view class="nutrition-info" aria-live="polite" aria-label="{{selected.name+', '+selected.total+' grams recorded'+(selected.goal === null ? '' : ', daily target '+selected.goal+' grams')+(selected.excess > 0 ? ', '+selected.excess+' grams over target' : '')+(selected.partial ? ', partial data' : '')}}">
    <view class="nutrition-line {{textFading ? 'is-fading' : ''}}"><view class="nutrition-heading"><view class="nutrition-color" style="{{'background:'+displayed.color+';'}}" aria-hidden="true"/><text class="nutrition-name">{{displayed.label || displayed.name}}</text></view><view class="nutrition-total">{{displayed.total}}/{{displayed.goal === null ? '—' : displayed.goal}}<text class="nutrition-unit">g</text></view></view>
  </view>
</view>
