@import './font.wxss';
:host { display:block;width:100%; }
.firmware-scale { position:relative;width:100%;height:calc(80 * var(--scale-unit));background:transparent;color:#000;font-family:'KcalScale',sans-serif;overflow:hidden; }
.scale-info { position:absolute;left:0;top:0;width:38.125%;height:100%;font-size:calc(28 * var(--scale-unit));font-weight:400;line-height:calc(32 * var(--scale-unit));white-space:nowrap; }
.container-value,.total-value { position:absolute;left:0;max-width:100%; }.container-value { top:0; }.total-value { bottom:0; }
.scale-capsule { position:absolute;left:38.75%;top:0;width:61.25%;height:100%;border-radius:999px;background:#b7de00;color:#000; }
.scale-digits { position:absolute;right:calc(25 * var(--scale-unit));top:calc(16 * var(--scale-unit));height:calc(48 * var(--scale-unit));display:flex;justify-content:flex-end;align-items:center;font-size:calc(36 * var(--scale-unit));font-weight:500;line-height:calc(48 * var(--scale-unit)); }
.digit { display:block;flex:none;width:calc(32 * var(--scale-unit));text-align:center; }.digit.decimal { width:calc(11 * var(--scale-unit)); }.scale-digits { transform-origin:right center; }
.scale-unit { position:absolute;right:calc(3 * var(--scale-unit));top:calc(35 * var(--scale-unit));width:calc(20 * var(--scale-unit));font-size:calc(24 * var(--scale-unit));font-weight:500;line-height:calc(18 * var(--scale-unit));text-align:center; }
/* Match firmware baselines: main/g at 53px, stacked oz at 37px/55px. */
.scale-unit.is-oz { top:calc(19 * var(--scale-unit)); }
.unit-letter { display:block; }
.scale-input { position:absolute;left:0;top:0;width:100%;height:100%;padding:0 calc(25 * var(--scale-unit)) 0 calc(12 * var(--scale-unit));box-sizing:border-box;color:transparent;background:transparent;font-family:'KcalScale',sans-serif;font-size:calc(36 * var(--scale-unit));font-weight:500;text-align:right;caret-color:#000; }
.scale-capsule.is-editing { box-shadow:inset 0 -2px 0 rgba(0,0,0,.3); }
.is-overloaded { border-radius:999px;background:#eb4451;display:flex;align-items:center;justify-content:center; }.overload { font-size:calc(32 * var(--scale-unit));font-weight:500; }
