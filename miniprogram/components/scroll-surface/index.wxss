:host { display:block; width:100%; height:100%; min-height:0; }
.surface { position:relative; width:100%; height:100%; min-height:0; }
.viewport { width:100%; height:100%; }
.content { width:100%; }
.scroll-rail { position:absolute; right:12rpx; top:50%; transform:translateY(-50%); width:28rpx; display:flex; flex-direction:column; align-items:flex-end; gap:14rpx; pointer-events:none; z-index:5; }
.tick { width:8rpx; height:3rpx; min-height:1px; border-radius:3rpx; background:#353831; opacity:.24; }
.tick.adjacent { width:14rpx; opacity:.42; }.tick.active { width:28rpx; opacity:.85; }
