.device-info-row { display:flex; align-items:center; gap:12rpx; flex-wrap:wrap; }.device-info-name { flex:1; min-width:160rpx; font-size:30rpx; font-weight:600; overflow-wrap:anywhere; }.status-mark { width:12rpx; height:12rpx; border-radius:50%; background:#9bA38f; }.status-mark.online { background:#9bbc00; }.device-actions { display:flex; flex-direction:column; gap:20rpx; margin-top:32rpx; }.device-action { width:100%; flex:none; min-width:0; }.reset-action { color:#b33e42; background:#fbe9e9; border-radius:999rpx; min-height:48px; font-size:28rpx; font-weight:600; }.reset-action::after { border:0; }.oad-reveal { max-height:0; opacity:0; overflow:hidden; transition:max-height 350ms ease,opacity 250ms ease; }.oad-reveal.is-open { max-height:180rpx; opacity:1; }.oad-inner { padding-top:28rpx; }.oad-inner .progress { margin-top:18rpx; }@media(prefers-reduced-motion:reduce){.oad-reveal { transition:none; }}
