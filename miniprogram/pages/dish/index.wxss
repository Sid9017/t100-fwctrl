.dish-body { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.dish-header { display:flex;align-items:center;justify-content:space-between;margin:16rpx 0 36rpx;gap:20rpx; }
.dish-header .title { margin:0; }
.dish-close { position:relative;width:48px;height:48px;min-height:48px;padding:0;background:#f7f7f7;flex:none; }
.dish-photo-row { display:flex;align-items:center;gap:24rpx;margin:0 0 32rpx; }
.dish-photo { flex:none;width:180rpx;height:180rpx;border-radius:36rpx; }
.dish-container-card { padding:32rpx 24rpx;overflow:visible; }
.dish-scale-row { display:flex;align-items:flex-start;flex:1;min-width:0;gap:12rpx; }
.dish-scale-display { flex:1;min-width:0; }
.weight-label { position:relative;flex:none;width:40rpx;height:40rpx; }
/* Keep the icon visible while the asynchronous Rive subpackage loads. */
.weight-bot-fallback { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.weight-bot-status { position:relative; }
.close-symbol { position:absolute;inset:0; }
.close-stroke { position:absolute;left:50%;top:50%;width:26px;height:3px;background:#353535;border-radius:2px;transform:translate(-50%,-50%) rotate(45deg); }
.close-stroke.second { transform:translate(-50%,-50%) rotate(-45deg); }
