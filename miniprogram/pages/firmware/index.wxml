<view class="shell profile-{{profile}}"><view class="header"><view class="brand brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><button class="header-settings" aria-label="Device settings" bindtap="openSettings"><image class="ui-icon" aria-hidden="true" src="/assets/icons/settings.svg"/></button><view class="connection-chip {{connected ? 'is-connected' : ''}}"><view class="state-dot"/><text>{{preview ? 'Preview' : stateLabel}}</text></view></view><view class="preview-banner" wx:if="{{preview}}"><text>DEVTOOLS PREVIEW</text><picker range="{{previewScenes}}" value="{{sceneIndex}}" bindchange="onScene"><view>{{previewScenes[sceneIndex]}} ▾</view></picker></view><scroll-surface class="screen" refresh-key="{{showTools+':'+showFirmwareDetails+':'+showPrevious+':'+showOtherDevices+':'+newNearbyDevices.length+':'+activity.length+':'+containerLibrary.length+':'+connected+':'+error+':'+feedback}}"><view class="screen-content">

        <view class="firmware-heading"><text class="eyebrow">FIRMWARE</text><text class="title">A fresh start.</text></view>
        <view class="firmware-card"><text class="card-title">Signed OAD firmware</text><button class="firmware-file" disabled="{{busy || working}}" bindtap="chooseFirmware">{{firmwareInfo ? 'KCALACK_OAD.bin' : 'Choose BIN + manifest'}}</button><text class="firmware-note">{{firmwareLoading ? 'Loading latest firmware…' : sameFirmware ? 'Your KCALACK is up to date.' : firmwareInfo ? firmwareSize+' · Verified and ready' : 'Select local firmware or load the latest release.'}}</text><view class="firmware-tools"><button class="text-button" disabled="{{busy || working || firmwareLoading}}" bindtap="reloadFirmware">Load latest</button><button class="text-button" disabled="{{busy || working}}" bindtap="chooseFirmware">Local files</button></view><button class="activity-toggle" bindtap="toggleFirmwareDetails">{{showFirmwareDetails ? '▾ Details' : '▸ Details'}}</button><view class="firmware-details" wx:if="{{showFirmwareDetails}}"><view><text>Current version</text><text>{{firmware}}</text></view><view><text>Version</text><text>{{firmwareInfo.version || 'Not selected'}}</text></view><view><text>Uploaded</text><text>{{firmwareInfo ? uploadedText : 'Not available'}}</text></view><view class="hash-row"><text>SHA256</text><text selectable>{{firmwareInfo.sha256 || 'Not available'}}</text></view></view><view class="progress-label"><text>OAD progress</text><text>{{progressText}}%</text></view><view class="progress-track"><view style="{{'width:'+ oadProgress +'%;'}}"/></view></view>
        <view class="warning" wx:if="{{!bound || !hasAuth}}">{{!bound ? 'Bind your KCALACK before upgrading.' : 'Restore this device’s auth backup before upgrading.'}}</view><view class="error" wx:if="{{firmwareError}}">{{firmwareError}}</view><button class="primary" disabled="{{!canOad || working}}" loading="{{actionName === 'downloadOad'}}" bindtap="startOad">{{sameFirmware ? 'Already up to date' : actionName === 'downloadOad' ? 'Upgrading…' : 'Start OAD'}}</button><view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view><button class="activity-toggle" bindtap="toggleActivity">Activity</button>


    </view></scroll-surface><include src="../shared/sheets.wxml"/></view>
