<view class="app-page theme-{{themeProfile}}"><scroll-surface reset-key="{{playIntro}}" refresh-key="{{date+':'+records.length+':'+profile+':'+error+':'+connected}}"><view class="page-body" wx:if="{{profile}}">
  <view class="app-top main-top home-top"><view class="wordmark brand-lockup"><scalebot class="brand-logo" demo="{{preview}}" intro="{{playIntro}}" active="{{pageVisible}}" no-device="{{preview && !hasDevice}}" bindfinished="pairingFinished"/><text>KCALACK</text></view><view class="top-actions">
    <button class="round-button" aria-label="Statistics" bindtap="openReports"><image class="ui-icon" aria-hidden="true" src="/assets/icons/chart-bar.svg"/></button>
    <button class="round-button" aria-label="Settings" bindtap="openProfile"><image class="ui-icon" aria-hidden="true" src="/assets/icons/settings.svg"/></button>
    <button wx:if="{{!hasDevice}}" class="round-button add-device-hint" aria-label="Add device" disabled="{{addBusy}}" bindtap="openAddDevice"><image class="add-device-orbit {{showDeviceSetup || addBusy || !pageVisible ? 'is-paused' : ''}}" aria-hidden="true" src="/assets/ui/add-device-orbit.svg"/><image class="ui-icon" aria-hidden="true" src="/assets/icons/plus.svg"/></button>
  </view></view>
  <view class="home-greeting"><text class="title">Today.</text></view>
  <view class="card energy-card {{summary.tone}}" wx:if="{{profile}}"><view class="row energy-heading"><view class="energy-total"><text class="muted">{{summary.remaining >= 0 ? 'Remaining today' : 'Above your target'}}</text><view class="big-number">{{summary.remaining >= 0 ? summary.remaining : -summary.remaining}}<text class="number-unit">KCAL</text></view></view><button class="add-meal" aria-label="Add a meal" bindtap="newMeal"><text>Add meal</text><image class="ui-icon" aria-hidden="true" src="/assets/icons/plus-light.svg"/></button></view><view class="energy-progress progress"><view style="{{'width:'+summary.progress+'%;'}}"/></view><view class="row"><text class="muted">{{summary.consumed}} consumed</text><text class="muted">Target {{summary.target}}</text></view><nutrition-rings nutrients="{{summary.nutrients}}"/></view>
  <view class="card"><view class="card-heading"><text>Food journal</text></view><button class="meal-row journal-meal" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="editMeal"><view class="journal-photos" wx:if="{{item.photos.length}}"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="*this" wx:if="{{photoIndex < 5}}" class="journal-photo" src="{{photo}}" mode="aspectFill" aria-hidden="true"/></view><view class="meal-info"><text class="meal-meta">{{item.mealLabel}} · {{item.timeLabel}}</text><text class="meal-kcal">{{item.kcal === null ? '—' : item.kcal}}<text class="number-unit">KCAL</text></text></view><text class="chevron">›</text></button></view>
  <view class="error" wx:if="{{error || syncError}}">{{error || syncError}}</view>
</view></scroll-surface><device-setup wx:if="{{showDeviceSetup}}" demo="{{preview}}" bindclose="closeDeviceSetup" bindconnected="deviceAdded"/></view>
