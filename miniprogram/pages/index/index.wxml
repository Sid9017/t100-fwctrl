<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{date+':'+records.length+':'+profile+':'+error+':'+connected+':'+liveLayout}}"><view class="page-body" wx:if="{{profile}}">
  <view class="app-top home-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><view class="top-actions">
    <button class="round-button" aria-label="Statistics" bindtap="openReports"><image class="ui-icon" aria-hidden="true" src="/assets/icons/chart-bar.svg"/></button>
    <button class="round-button" aria-label="Settings" bindtap="openProfile"><image class="ui-icon" aria-hidden="true" src="/assets/icons/settings.svg"/></button>
    <button wx:if="{{!hasDevice}}" class="round-button add-device-hint" aria-label="Add device" disabled="{{addBusy}}" bindtap="openAddDevice"><image class="add-device-orbit {{showDeviceSetup || addBusy || !pageVisible ? 'is-paused' : ''}}" aria-hidden="true" src="/assets/ui/add-device-orbit.svg"/><image class="ui-icon" aria-hidden="true" src="/assets/icons/plus.svg"/></button>
  </view></view>
  <view class="home-greeting"><text class="title">Today.</text><view wx:if="{{hasDevice}}" class="device-pill {{connected ? 'online' : ''}}" role="status"><view/><text>{{connected ? 'Connected' : connecting ? 'Connecting…' : 'Disconnected'}}</text></view></view>
  <view wx:if="{{connected}}" class="home-live {{liveReady ? 'is-ready' : ''}} {{liveSettled ? 'is-settled' : ''}}"><live-device id="liveDevice" demo="{{preview}}" intro="{{playIntro}}" active="{{pageVisible && !showDeviceSetup}}" bindloaded="liveLoaded" bindlayoutchange="liveLayoutChanged"/></view>
  <view class="card energy-card {{summary.tone}}" wx:if="{{profile}}"><view class="row energy-heading"><view class="energy-total"><text class="muted">{{summary.remaining >= 0 ? 'Remaining today' : 'Above your target'}}</text><view class="big-number">{{summary.remaining >= 0 ? summary.remaining : -summary.remaining}}<text class="number-unit">KCAL</text></view></view><button class="add-meal" aria-label="Add a meal" bindtap="newMeal"><text>Add meal</text><image class="ui-icon" aria-hidden="true" src="/assets/icons/plus-light.svg"/></button></view><view class="energy-progress progress"><view style="{{'width:'+summary.progress+'%;'}}"/></view><view class="row"><text class="muted">{{summary.consumed}} consumed</text><text class="muted">Target {{summary.target}}</text></view><view class="nutrients"><view class="nutrient" wx:for="{{summary.nutrients}}" wx:key="key"><text class="muted">{{item.label}}</text><view class="progress"><view class="{{item.key}}" style="{{'width:'+item.progress+'%;'}}"/></view><text class="nutrient-value">{{item.total}}<text class="muted inline"> / {{item.goal}} g{{item.partial ? ' · partial' : ''}}</text></text></view></view></view>
  <view class="card"><view class="card-heading"><text>Food journal</text><text class="muted">{{records.length}} records</text></view><button class="meal-row" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="editMeal"><image wx:if="{{item.photo}}" class="meal-photo" src="{{item.photo}}" mode="aspectFill"/><view class="meal-info"><text class="meal-meta">{{item.mealLabel}} · {{item.timeLabel}}</text><text class="meal-name">{{item.name}}</text><text class="meal-kcal">{{item.kcal}}<text class="number-unit">KCAL</text></text></view><text class="chevron">›</text></button></view>
  <button class="secondary" loading="{{loading}}" bindtap="syncPlan" wx:if="{{connected && profile}}">Sync today’s plan to device</button><view class="error" wx:if="{{error}}">{{error}}</view>
</view></scroll-surface><device-setup wx:if="{{showDeviceSetup}}" demo="{{preview}}" bindclose="closeDeviceSetup"/></view>
