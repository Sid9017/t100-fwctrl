.energy-card { margin-top:12rpx; }.energy-card .big-number { margin:16rpx 0 24rpx; }.add-meal { width:auto; min-height:48px; flex:none; gap:12px; padding:12px 12px 12px 16px; border-radius:999rpx; background:#353535; color:#fff; font-size:26rpx; font-weight:600; white-space:nowrap; }.add-meal .ui-icon { width:24px; height:24px; }.energy-heading { flex-wrap:wrap; gap:12rpx; }.energy-total { min-width:0; }.energy-total .big-number { white-space:nowrap; }.energy-progress { margin-bottom:8rpx; }.warning .big-number { color:#aa7b00; }.danger .big-number { color:#c5454b; }.warning .energy-progress > view { background:#fed563; }.danger .energy-progress > view { background:#f36c76; }.inline { display:inline; }.small-title { font-size:40rpx; }.card > .primary { margin-top:24rpx; }.dev-preview { border:1px dashed #b7c787; border-radius:40rpx; padding:28rpx; margin-top:36rpx; }.dev-preview .card-heading { margin-bottom:16rpx; }
@media(max-width:350px){.home-greeting { align-items:flex-start; flex-direction:column; }}

.home-greeting { margin-bottom:40rpx; }.card:last-of-type .card-heading { margin-bottom:0; }

.home-top { gap:12rpx; }.top-actions { margin-left:auto; display:flex; justify-content:flex-end; align-items:center; gap:4rpx; flex:none; }.home-top .round-button { width:44px; min-height:48px; background:transparent; }.home-top .ui-icon { width:24px; height:24px; }.home-top .wordmark { font-size:28rpx; letter-spacing:1rpx; }.home-greeting { align-items:center; margin-top:16rpx; margin-bottom:32rpx; }
@media(max-width:350px){.home-top { gap:4rpx; }.top-actions { gap:0; }.home-top .wordmark { font-size:26rpx; }.home-greeting { flex-direction:row; }}


.home-greeting { margin-top:0; margin-bottom:32rpx; }

.journal-meal { align-items:center; }
.journal-meal .meal-info { text-align:right; }
.journal-photos { display:flex;align-items:center;gap:8rpx;flex:none; }
.journal-photo { display:block;flex:none;width:56rpx;height:56rpx;border-radius:50%;background:#f7f7fa; }
.journal-meal .meal-kcal { display:block;white-space:nowrap; }
