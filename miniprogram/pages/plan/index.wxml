<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{step+':'+error+':'+preview}}" reset-key="{{step}}"><view class="page-body plan-page {{step === 3 ? 'review' : ''}}">
  <view class="preview-label" wx:if="{{preview && step !== 3}}">Devtools preview · separate personal plan</view><view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><view class="row"><picker wx:if="{{isDevtools}}" range="{{previewPages}}" bindchange="previewPage"><view class="dev-preview-button">Preview ▾</view></picker><text class="muted">{{step+1}} / 4</text></view></view><view class="progress onboarding-progress"><view style="{{'width:'+progress+'%;'}}"/></view>
  <view wx:if="{{!preview && (restoring || restoreError)}}" class="card"><text wx:if="{{restoring}}">Loading your plan…</text><block wx:else><text class="error">{{restoreError}}</text><button class="secondary" bindtap="restore">Retry</button></block></view><block wx:else>
  <image wx:if="{{step < 3}}" class="kcalbot" src="/assets/ui/kcalbot.svg" mode="aspectFit"/>
  <block wx:if="{{step === 0}}"><text class="title">About you.</text><view class="card"><text class="card-heading">Sex</text><button wx:for="{{sexes}}" wx:key="value" class="choice {{form.sex === item.value ? 'selected' : ''}}" data-field="sex" data-value="{{item.value}}" bindtap="select"><text>{{item.label}}</text><view class="choice-dot"/></button><view class="birthday-field"><text class="card-heading">Birthday</text><view class="birthday-wheel-frame"><picker-view class="birthday-wheel" value="{{birthdayIndices}}" bindchange="onBirthday" indicator-class="birthday-wheel-indicator" indicator-style="height:48px;" mask-class="birthday-wheel-mask" immediate-change aria-label="Birthday, year month day">
      <picker-view-column aria-label="Year"><view wx:for="{{birthdayYears}}" wx:key="*this" class="birthday-wheel-item {{index === birthdayIndices[0] ? 'is-selected' : ''}}">{{item}}</view></picker-view-column>
      <picker-view-column aria-label="Month"><view wx:for="{{birthdayMonths}}" wx:key="*this" class="birthday-wheel-item {{index === birthdayIndices[1] ? 'is-selected' : ''}}">{{birthdayMonthLabels[item-1]}}</view></picker-view-column>
      <picker-view-column aria-label="Day"><view wx:for="{{birthdayDays}}" wx:key="*this" class="birthday-wheel-item {{index === birthdayIndices[2] ? 'is-selected' : ''}}">{{item}}</view></picker-view-column>
    </picker-view></view></view></view></block>
  <block wx:elif="{{step === 1}}"><text class="title">Your body.</text><view class="card"><view class="form-grid"><label class="field">Height · cm<input disabled="{{loading}}" type="number" value="{{form.height}}" data-field="height" bindinput="onField"/></label><label class="field">Weight · kg<input disabled="{{loading}}" type="digit" value="{{form.weight}}" data-field="weight" bindinput="onField"/></label></view><label class="field">Body fat · % · optional<input disabled="{{loading}}" type="digit" value="{{form.bodyFat}}" data-field="bodyFat" bindinput="onField" placeholder="Skip if unknown" placeholder-style="color:#6b7064"/></label><label class="field activity-field">Activity level<picker range="{{activity}}" value="{{form.activity}}" bindchange="onActivity"><view class="picker-value">{{activity[form.activity]}} ▾</view></picker></label></view></block>
  <block wx:elif="{{step === 2}}"><text class="title">Your goal.</text><view class="card"><button wx:for="{{goals}}" wx:key="value" class="choice {{form.goal === item.value ? 'selected' : ''}}" data-field="goal" data-value="{{item.value}}" bindtap="select"><view><text>{{item.label}}</text><text class="muted">{{item.detail}}</text></view><view class="choice-dot"/></button><view class="form-grid" wx:if="{{form.goal !== 'maintain'}}"><label class="field">Goal weight · kg<input disabled="{{loading}}" type="digit" value="{{form.goalWeight}}" data-field="goalWeight" bindinput="onField"/></label><label class="field">Weekly change · kg<input disabled="{{loading}}" type="digit" value="{{form.paceKgPerWeek}}" data-field="paceKgPerWeek" bindinput="onField"/></label></view></view></block>
  <block wx:else><text class="title">Your plan.</text>
    <view class="card energy-plan"><text class="card-heading">Daily energy · kcal</text><view class="form-grid"><label class="field">Intake target<input disabled="{{loading}}" type="number" value="{{form.target}}" data-field="target" bindinput="onField"/></label><label class="field">TDEE<view class="picker-value">{{form.tdee}}</view></label></view></view>
    <view class="card nutrition-plan"><view class="card-heading"><text>Nutrition</text><text class="macro-total {{form.carbs*1+form.protein*1+form.fat*1 !== 100 ? 'invalid' : ''}}">{{form.carbs*1+form.protein*1+form.fat*1}}%</text></view><view class="macro-grid"><label class="field">Carbs · %<input disabled="{{loading}}" type="digit" value="{{form.carbs}}" data-field="carbs" bindinput="onField"/></label><label class="field">Protein · %<input disabled="{{loading}}" type="digit" value="{{form.protein}}" data-field="protein" bindinput="onField"/></label><label class="field">Fat · %<input disabled="{{loading}}" type="digit" value="{{form.fat}}" data-field="fat" bindinput="onField"/></label><label class="field">Fiber · g<input disabled="{{loading}}" type="digit" value="{{form.fiber}}" data-field="fiber" bindinput="onField"/></label></view></view>
  </block>
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="actions wizard-actions"><button class="secondary" wx:if="{{step > 0}}" bindtap="back">Back</button><button class="primary" wx:if="{{step < 3}}" bindtap="next" loading="{{loading}}" disabled="{{loading}}">{{step === 2 ? 'Save and calculate' : 'Continue'}}</button><button class="primary" wx:else loading="{{loading}}" bindtap="save" disabled="{{loading}}">{{editing ? 'Save my plan' : 'Let’s begin'}}</button></view>
</block></view></scroll-surface></view>
