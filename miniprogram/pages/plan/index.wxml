<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{step+':'+error+':'+preview}}" reset-key="{{step}}"><view class="page-body plan-page {{step === 3 ? 'review' : ''}}">
  <view class="preview-label" wx:if="{{preview && step !== 3}}">Devtools preview · separate personal plan</view><view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><view class="row"><picker wx:if="{{isDevtools}}" range="{{previewPages}}" bindchange="previewPage"><view class="dev-preview-button">Preview ▾</view></picker><text class="muted">{{step+1}} / 4</text></view></view><view class="progress onboarding-progress"><view style="{{'width:'+progress+'%;'}}"/></view>
  <image wx:if="{{step < 3}}" class="kcalbot" src="/assets/ui/kcalbot.svg" mode="aspectFit"/>
  <block wx:if="{{step === 0}}"><text class="title">About you.</text><view class="card"><text class="card-heading">Sex</text><button wx:for="{{sexes}}" wx:key="value" class="choice {{form.sex === item.value ? 'selected' : ''}}" data-field="sex" data-value="{{item.value}}" bindtap="select"><text>{{item.label}}</text><view class="choice-dot"/></button><label class="field">Age · years<input type="number" value="{{form.age}}" data-field="age" bindinput="onField" placeholder="Enter age" placeholder-style="color:#6b7064"/></label><text class="muted">Private? Enter TDEE manually.</text></view></block>
  <block wx:elif="{{step === 1}}"><text class="title">Your body.</text><view class="card"><view class="form-grid"><label class="field">Height · cm<input type="digit" value="{{form.height}}" data-field="height" bindinput="onField"/></label><label class="field">Weight · kg<input type="digit" value="{{form.weight}}" data-field="weight" bindinput="onField"/></label></view><label class="field">Body fat · % · optional<input type="digit" value="{{form.bodyFat}}" data-field="bodyFat" bindinput="onField" placeholder="Skip if unknown" placeholder-style="color:#6b7064"/></label><label class="field activity-field">Activity level<picker range="{{activity}}" value="{{form.activity}}" bindchange="onActivity"><view class="picker-value">{{activity[form.activity]}} ▾</view></picker></label></view></block>
  <block wx:elif="{{step === 2}}"><text class="title">Your goal.</text><view class="card"><button wx:for="{{goals}}" wx:key="value" class="choice {{form.goal === item.value ? 'selected' : ''}}" data-field="goal" data-value="{{item.value}}" bindtap="select"><view><text>{{item.label}}</text><text class="muted">{{item.detail}}</text></view><view class="choice-dot"/></button><view class="form-grid" wx:if="{{form.goal !== 'maintain'}}"><label class="field">Goal weight · kg<input type="digit" value="{{form.goalWeight}}" data-field="goalWeight" bindinput="onField"/></label><label class="field">Planned timeline · months<input type="number" value="{{form.months}}" data-field="months" bindinput="onField"/></label></view><label class="field" wx:if="{{form.sex === 'private'}}">TDEE · kcal<input type="number" value="{{form.tdee}}" data-field="tdee" bindinput="onField"/></label></view></block>
  <block wx:else><text class="title">Your plan.</text>
    <view class="card energy-plan"><text class="card-heading">Daily energy · kcal</text><view class="form-grid"><label class="field">Intake target<input type="number" value="{{form.target}}" data-field="target" bindinput="onField"/></label><label class="field">TDEE<input type="number" value="{{form.tdee}}" data-field="tdee" bindinput="onField"/></label></view><text class="estimate-note">Editable estimate.</text></view>
    <view class="card nutrition-plan"><view class="card-heading"><text>Nutrition</text><text class="macro-total {{form.carbs*1+form.protein*1+form.fat*1 !== 100 ? 'invalid' : ''}}">{{form.carbs*1+form.protein*1+form.fat*1}}%</text><button class="round-button recalculate-plan" aria-label="Check nutrition plan" bindtap="recalculate"><image class="ui-icon" aria-hidden="true" src="/assets/icons/refresh.svg"/></button></view><view class="macro-grid"><label class="field">Carbs · %<input type="digit" value="{{form.carbs}}" data-field="carbs" bindinput="onField"/></label><label class="field">Protein · %<input type="digit" value="{{form.protein}}" data-field="protein" bindinput="onField"/></label><label class="field">Fat · %<input type="digit" value="{{form.fat}}" data-field="fat" bindinput="onField"/></label><label class="field">Fiber · g<input type="digit" value="{{form.fiber}}" data-field="fiber" bindinput="onField"/></label></view></view>
  </block>
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="actions wizard-actions"><button class="secondary" wx:if="{{step > 0}}" bindtap="back">Back</button><button class="primary" wx:if="{{step < 3}}" bindtap="next">Continue</button><button class="primary" wx:else loading="{{loading}}" bindtap="save">{{editing ? 'Save my plan' : 'Let’s begin'}}</button></view>
</view></scroll-surface></view>
