<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{backupPath+':'+profile+':'+error}}"><view class="page-body"><view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><image class="profile-mark" src="/assets/ui/kcalbot.svg" mode="aspectFit"/></view><text class="title">Your profile.</text><view class="card"><view class="card-heading"><text>Personal plan</text><button class="text-button" bindtap="plan">{{profile ? 'Edit →' : 'Create →'}}</button></view><block wx:if="{{profile}}"><view class="big-number">{{profile.target}}<text class="number-unit">KCAL / DAY</text></view><view class="line row"><text>Estimated TDEE</text><text>{{profile.tdee}} kcal</text></view><view class="line row"><text>Goal</text><text>{{profile.goal === 'lose' ? 'Lose weight' : profile.goal === 'gain' ? 'Gain weight' : 'Maintain'}}</text></view><view class="line row"><text>Starting weight</text><text>{{profile.weight}} kg</text></view><view class="line row" wx:if="{{profile.goal !== 'maintain'}}"><text>Goal weight</text><text>{{profile.goalWeight}} kg</text></view></block><text class="muted" wx:else>Create your plan to personalise your daily targets.</text></view><view class="card"><button class="settings-row" bindtap="devices"><view><text>My devices</text><text class="muted">Connect, auth backup and firmware</text></view><text>›</text></button><button class="settings-row" bindtap="reports"><view><text>Your reports</text><text class="muted">{{recordCount}} meals in your journal</text></view><text>›</text></button><view class="line row"><text>Saved containers</text><text>{{containerCount}}</text></view></view><view class="card"><text class="card-heading">On this phone</text><text class="muted">Local journal. Auth backup is in device settings.</text><button class="secondary export-journal" bindtap="exportJournal">Export journal JSON</button><button class="lime export-journal" wx:if="{{backupPath}}" bindtap="shareJournal">Share journal JSON</button><text class="subtitle" wx:if="{{pendingDeletes}}">{{pendingDeletes}} device deletions waiting for sync.</text></view><view class="card" wx:if="{{isDevtools}}"><picker range="{{previewPages}}" bindchange="previewPage"><button class="secondary">Preview screens</button></picker></view><view class="error" wx:if="{{error}}">{{error}}</view></view></scroll-surface></view>
