<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{profile+':'+containerCount+':'+error}}"><view class="page-body"><view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view></view><text class="title">Your profile.</text><view class="card"><view class="card-heading"><text>Personal plan</text><button class="text-button" bindtap="plan">{{profile ? 'Edit →' : 'Create →'}}</button></view><block wx:if="{{profile}}"><view class="big-number">{{profile.target}}<text class="number-unit">KCAL / DAY</text></view><view class="line row"><text>Estimated TDEE</text><text>{{profile.tdee}} kcal</text></view><view class="line row"><text>Goal</text><text>{{profile.goal === 'lose' ? 'Lose weight' : profile.goal === 'gain' ? 'Gain weight' : 'Maintain'}}</text></view><view class="line row"><text>Starting weight</text><text>{{profile.weight}} kg</text></view><view class="line row" wx:if="{{profile.goal !== 'maintain'}}"><text>Goal weight</text><text>{{profile.goalWeight}} kg</text></view></block><text class="muted" wx:else>Create your plan to personalise your daily targets.</text></view><view class="card"><view class="row unit-setting"><view class="unit-setting-label"><text>Weight unit</text><text wx:if="{{unitSyncing}}" class="unit-sync-status" aria-live="polite">Syncing…</text></view><button class="unit-switch {{unit === 1 ? 'is-oz' : ''}}" bindtap="toggleUnit" aria-label="{{unit === 1 ? 'Weight unit: ounces. Switch to grams' : 'Weight unit: grams. Switch to ounces'}}"><view class="unit-track"><text class="unit-track-label unit-label-oz" aria-hidden="true">oz</text><text class="unit-track-label unit-label-g" aria-hidden="true">g</text><view class="unit-thumb"/></view></button></view><text wx:if="{{unitError}}" class="error">{{unitError}}</text></view><view class="card"><button class="settings-row" bindtap="devices"><view><text>My device</text></view><text>›</text></button><view class="line row"><text>Saved containers</text><text>{{containerCount}}</text></view></view><view class="card" wx:if="{{isDevtools}}"><picker range="{{previewPages}}" bindchange="previewPage"><button class="secondary">Preview screens</button></picker></view><view class="error" wx:if="{{error}}">{{error}}</view></view></scroll-surface></view>
