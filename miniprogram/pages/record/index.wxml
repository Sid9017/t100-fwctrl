<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{summary+':'+showNutrition+':'+form.photos.length+':'+error+':'+feedback}}"><view class="page-body">
  <view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><text class="muted">FOOD JOURNAL</text></view><view class="preview-label" wx:if="{{preview}}">Devtools preview · separate journal</view>
  <block wx:if="{{!summary}}"><text class="title">{{editing ? 'Edit meal.' : 'New meal.'}}</text>
    <view class="photo-strip"><view class="photo-slot" wx:for="{{form.photos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-path="{{item}}" bindtap="previewPhoto"/><button class="remove-photo" aria-label="Remove photo" data-index="{{index}}" bindtap="removePhoto"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view><button wx:if="{{form.photos.length < 3}}" class="photo-slot add-photo" aria-label="Add meal photo" loading="{{loading}}" bindtap="choosePhoto"><image class="ui-icon" aria-hidden="true" src="/assets/icons/camera.svg"/></button></view>
    <view class="recognition-slot"><text>Food recognition</text><text>Coming later</text></view>
    <view class="card"><label class="field">Meal name<input maxlength="80" value="{{form.name}}" data-field="name" bindinput="field" placeholder="What’s on your plate?" placeholder-style="color:#6b7064"/></label><view class="form-grid"><label class="field">Meal<picker range="{{meals}}" value="{{mealIndex}}" bindchange="meal"><view class="picker-value">{{form.meal}} ▾</view></picker></label><label class="field">Date<picker mode="date" value="{{form.date}}" end="{{today}}" bindchange="date"><view class="picker-value">{{form.date}}</view></picker></label><label class="field">Time<picker mode="time" value="{{form.time}}" bindchange="time"><view class="picker-value">{{form.time}}</view></picker></label><label class="field">Weight · g · optional<input type="digit" value="{{form.weight}}" data-field="weight" bindinput="field"/></label></view><label class="field calorie-field">Calories · kcal<input type="number" value="{{form.kcal}}" data-field="kcal" bindinput="field" placeholder="Enter calories" placeholder-style="color:#6b7064"/></label></view>
    <view class="card"><button class="nutrition-toggle" aria-expanded="{{showNutrition}}" bindtap="toggleNutrition"><text>Nutrition</text><text>{{showNutrition ? '▾' : '▸'}}</text></button><view wx:if="{{showNutrition}}"><view class="form-grid"><label class="field">Carbs · g<input type="digit" value="{{form.carbs}}" data-field="carbs" bindinput="field" placeholder="Unknown" placeholder-style="color:#6b7064"/></label><label class="field">Protein · g<input type="digit" value="{{form.protein}}" data-field="protein" bindinput="field" placeholder="Unknown" placeholder-style="color:#6b7064"/></label><label class="field">Fat · g<input type="digit" value="{{form.fat}}" data-field="fat" bindinput="field" placeholder="Unknown" placeholder-style="color:#6b7064"/></label><label class="field">Fiber · g<input type="digit" value="{{form.fiber}}" data-field="fiber" bindinput="field" placeholder="Unknown" placeholder-style="color:#6b7064"/></label></view><label class="field">Notes<textarea value="{{form.notes}}" data-field="notes" bindinput="field" maxlength="400" placeholder="Ingredients or anything you’d like to remember" placeholder-style="color:#6b7064"/></label></view><view class="row"><text class="muted">How was it?</text><view class="ratings" id="meal-rating" catchtouchstart="ratingStart" catchtouchmove="ratingMove"><button wx:for="{{ratingDots}}" wx:key="*this" class="rating-button {{item <= form.rating ? 'active' : ''}}" data-value="{{item}}" aria-label="{{item}} out of 5" bindtap="rating"><view/></button></view></view></view>

  </block>
  <block wx:else><text class="eyebrow">{{form.meal}} · {{form.date}} · {{form.time}}</text><text class="title">{{form.name}}</text><view class="card meal-summary"><view class="big-number">{{form.kcal}}<text class="number-unit">KCAL</text></view><text class="subtitle">{{form.weight !== null ? form.weight+' g · ' : ''}}Rating {{form.rating}} / 5</text><view class="photo-strip"><image wx:for="{{form.photos}}" wx:key="*this" class="summary-photo" src="{{item}}" mode="aspectFill" data-path="{{item}}" bindtap="previewPhoto"/></view><view class="nutrients"><view><text class="muted">Carbs</text><text>{{form.carbs === null ? 'Not recorded' : form.carbs+' g'}}</text></view><view><text class="muted">Protein</text><text>{{form.protein === null ? 'Not recorded' : form.protein+' g'}}</text></view><view><text class="muted">Fat</text><text>{{form.fat === null ? 'Not recorded' : form.fat+' g'}}</text></view><view><text class="muted">Fiber</text><text>{{form.fiber === null ? 'Not recorded' : form.fiber+' g'}}</text></view></view><text class="subtitle" wx:if="{{form.notes}}">{{form.notes}}</text></view><view class="actions"><button class="secondary" disabled="{{loading}}" bindtap="edit">Edit details</button><button class="lime" loading="{{loading}}" disabled="{{!canSync || loading}}" bindtap="sync">Send to device</button></view><text class="subtitle">Saved on this phone.</text></block>
  <view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view><button class="text-button delete-meal" wx:if="{{editing}}" disabled="{{loading}}" bindtap="remove">Delete meal</button>
</view></scroll-surface><view class="record-footer"><button wx:if="{{!summary}}" class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="save">Save meal</button><button wx:else class="primary" bindtap="done">Done</button></view></view>
