<view class="app-page theme-{{themeProfile}}"><scroll-surface refresh-key="{{summary+':'+detailsOpen+':'+form.photos.length+':'+error+':'+feedback}}"><view class="page-body">
  <block wx:if="{{!summary}}">
    <view class="meal-heading" aria-live="polite" aria-label="{{form.meal}}"><text wx:for="{{meals}}" wx:key="*this" class="title meal-title {{item === form.meal ? 'is-active' : ''}}" aria-hidden="{{item !== form.meal}}">{{item}}</text></view>

    <view class="photo-wheel {{loading || orbitPaused || photoEditing || deletingPhotoIndex >= 0 || !visible ? 'is-paused' : ''}}" bindtouchstart="skyTouchStart" catchtouchmove="skyTouchMove" bindtouchend="skyTouchEnd" bindtouchcancel="skyTouchCancel">
      <view class="wheel-sky">
        <image wx:if="{{!skyReady}}" class="sky-fallback" src="/assets/meals/sky-{{mealIndex}}.svg" aria-hidden="true"/>
        <meal-sky class="sky-animation" bindcapture="choosePhoto" bindready="skyLoaded" bindunavailable="skyUnavailable" meal="{{mealIndex}}" active="{{visible && !summary}}"/>
      </view>

      <cover-view class="photo-orbit">
        <cover-view wx:for="{{photoSlots}}" wx:key="index" class="orbit-slot slot-{{index}} {{item.path ? 'has-photo' : ''}}"><cover-view class="upright-photo">
          <cover-view wx:if="{{item.path}}" class="photo-item {{selectedPhotoIndex === index ? 'is-selected' : ''}} {{deletingPhotoIndex === index ? 'is-removing' : ''}}">
            <cover-view class="photo-frame" data-index="{{index}}" data-path="{{item.path}}" catchtap="selectPhoto" bindlongpress="previewPhoto" aria-role="button" aria-label="{{'Photo '+(index+1)+(selectedPhotoIndex === index ? ', selected' : '')}}"><cover-image class="orbit-photo" src="{{item.path}}"/></cover-view>
            <cover-view class="remove-photo" data-index="{{index}}" aria-role="button" aria-label="{{'Remove photo '+(index+1)}}" catchtap="removePhoto"><cover-image class="remove-icon" src="/assets/icons/x.svg"/></cover-view>
          </cover-view>
        </cover-view></cover-view>
      </cover-view>
      <cover-view class="capture-layer"><cover-view class="capture-button {{loading || form.photos.length >= 5 ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{form.photos.length < 5 ? 'Add a meal photo' : 'Five photos added'}}" aria-disabled="{{loading || form.photos.length >= 5}}" catchtap="choosePhoto"><cover-image class="capture-icon" src="{{form.photos.length < 5 ? '/assets/icons/camera-light.svg' : '/assets/icons/check-light.svg'}}"/></cover-view></cover-view>
    </view>
    <view class="meal-details {{detailsOpen ? 'is-open' : ''}}">
      <button class="details-toggle" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>Description</text><image src="/assets/icons/arrow-right.svg" class="details-arrow" aria-hidden="true"/></button>
      <view class="details-reveal"><view class="details-content">
        <textarea class="description-input" value="{{form.name}}" data-field="name" bindinput="field" bindfocus="editPhoto" bindblur="resumeOrbit" maxlength="80" placeholder="What’s on your plate?" aria-label="Meal description"/>
        <view class="form-grid"><label class="field">Weight · g<input type="digit" value="{{form.weight}}" data-field="weight" bindinput="field" placeholder="—" bindfocus="editPhoto" bindblur="resumeOrbit"/></label><label class="field">Calories · kcal<input type="number" value="{{form.kcal}}" data-field="kcal" bindinput="field" placeholder="—" bindfocus="editPhoto" bindblur="resumeOrbit"/></label></view>
      </view></view>
    </view>
    <view class="rating-section"><text class="rating-label">Rating</text>
      <view class="rating-row" id="meal-rating"><button wx:for="{{ratingDots}}" wx:key="*this" class="meal-rating {{item <= form.rating ? 'active' : ''}}" data-value="{{item}}" aria-label="{{item+' out of 5'+(form.rating === item ? ', selected' : '')}}" bindtap="rating"><view class="rating-dot" aria-hidden="true"/></button></view>
    </view>
  </block>
  <block wx:else><text class="eyebrow">{{form.meal}} · {{form.date}} · {{form.time}}</text><text class="title">{{form.name}}</text><view class="card meal-summary"><view class="big-number">{{form.kcal}}<text class="number-unit">KCAL</text></view><text class="subtitle">{{form.weight !== null ? form.weight+' g · ' : ''}}Rating {{form.rating}} / 5</text><view class="summary-photos"><image wx:for="{{form.photos}}" wx:key="*this" class="summary-photo" src="{{item}}" mode="aspectFill" data-path="{{item}}" bindtap="previewPhoto"/></view><text class="subtitle" wx:if="{{form.notes}}">{{form.notes}}</text></view><view class="actions"><button class="secondary" disabled="{{loading}}" bindtap="edit">Edit</button><button class="lime" loading="{{loading}}" disabled="{{!canSync || loading}}" bindtap="sync">Send to device</button></view></block>
  <view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view><button class="text-button delete-meal" wx:if="{{editing}}" disabled="{{loading}}" bindtap="remove">Delete meal</button>
</view></scroll-surface><view class="record-footer"><button wx:if="{{!summary}}" class="primary" loading="{{loading}}" disabled="{{loading || deletingPhotoIndex >= 0 || !form.id}}" bindtap="save">Save meal</button><button wx:else class="primary" bindtap="done">Done</button></view></view>
