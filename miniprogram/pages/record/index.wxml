<import src="../shared/nutrition-editor.wxml"/>
<view class="app-page theme-{{themeProfile}}"><scroll-surface reset-key="{{calculationView}}" refresh-key="{{summary+':'+detailsOpen+':'+form.photos.length+':'+error+':'+feedback+':'+connected+':'+containerRevealVersion+':'+selectedPhotoIndex+':'+nutritionOpen+':'+analysisError+':'+analyzing+':'+selectedDish.analysis.ingredients+':'+form.mealAnalysis.text}}"><view class="page-body">
  <block>
    <view class="meal-header">
    <view wx:if="{{mealLocked}}" class="meal-heading fixed-meal-heading"><text class="title">{{form.meal}}<text class="meal-time"> · {{form.time}}</text></text></view>
    <button wx:else class="meal-heading" bindtap="nextMeal" aria-disabled="{{analyzing || loading || deletingPhotoIndex >= 0 || !form.id}}" hover-class="none" aria-live="polite" aria-label="{{form.meal+', switch to '+meals[(mealIndex+1)%4]}}"><text wx:for="{{meals}}" wx:key="*this" class="title meal-title {{item === form.meal ? 'is-active' : ''}}" aria-hidden="{{item !== form.meal}}">{{item}}</text></button>
    <view class="meal-status" aria-live="polite">
      <text class="meal-status-text status-drag {{wheelDragging && !analyzing ? 'is-visible' : ''}}" aria-hidden="{{!wheelDragging || analyzing}}">Drag fast to analyze</text>
      <text class="meal-status-text status-analysis {{analyzing ? 'is-visible' : ''}}" aria-hidden="{{!analyzing}}">Analyzing…</text>
    </view>
    </view>

    <view class="photo-wheel {{wheelFrozen ? 'is-frozen' : ''}} {{!visible ? 'is-paused' : ''}} {{analyzing ? 'is-calculating' : ''}} {{wheelDragging ? 'is-dragging' : ''}} {{wheelArmed ? 'is-armed' : ''}}" style="--orbit-angle:{{orbitAngle}}deg;--counter-angle:{{-orbitAngle}}deg">
      <view class="wheel-sky">
        <image wx:if="{{mealLocked || !skyReady}}" class="sky-fallback" src="/assets/meals/sky-{{mealIndex}}.svg" aria-hidden="true"/>
        <meal-sky wx:if="{{!mealLocked}}" class="sky-animation" bindready="skyLoaded" bindunavailable="skyUnavailable" meal="{{mealIndex}}" active="{{visible && !summary}}"/>
      </view>

      <view id="meal-orbit" class="photo-orbit">
        <view wx:for="{{photoSlots}}" wx:key="index" class="orbit-slot slot-{{item.index}} {{item.path ? 'has-photo' : ''}}"><view id="wheel-counter-{{item.index}}" class="upright-photo">
          <view wx:if="{{item.path}}" class="photo-item {{item.status === 'ready' ? 'is-loaded' : item.status === 'failed' ? 'is-failed' : ''}} {{selectedPhotoIndex === item.index ? 'is-selected' : ''}} {{deletingPhotoIndex === item.index ? 'is-removing' : ''}}">
            <view class="photo-frame" bindtouchstart="wheelTouchStart" catchtouchmove="wheelTouchMove" bindtouchend="wheelTouchEnd" bindtouchcancel="cancelWheelDrag" data-index="{{item.index}}" data-path="{{item.path}}" catchtap="selectPhoto" aria-role="button" aria-label="{{'Photo '+(item.index+1)+(selectedPhotoIndex === item.index ? ', selected' : '')}}"><image mode="aspectFill" class="orbit-photo" src="{{item.path}}" data-index="{{item.index}}" data-path="{{item.path}}" bindload="photoLoaded" binderror="photoFailed"/></view>
            <view wx:if="{{!analyzing && selectedPhotoIndex === item.index}}" class="remove-photo" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80" data-index="{{item.index}}" aria-role="button" aria-label="{{'Remove photo '+(item.index+1)}}" catchtap="removePhoto"><view class="remove-disc"><image class="remove-icon" src="/assets/icons/x-bold.svg" aria-hidden="true"/></view></view>
          </view>
        </view></view>
      </view>
      <view class="capture-layer"><view class="capture-button center-{{centerMode}} center-{{centerPhase}} {{centerMode === 'camera' && centerPhase === 'idle' && !analyzing && (loading || form.photos.length >= 5) ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{analyzing ? analysisPhase : 'Add a dish photo. Hold to analyze meal.'}}" aria-disabled="{{analyzing || loading}}" catchtap="centerTap" bindlongpress="centerLongPress"><image class="capture-icon" src="/assets/icons/camera-light.svg"/><view class="analysis-heart" aria-hidden="true"><image src="/assets/icons/analysis-heart.svg"/></view></view></view>
    </view>
    <view class="dish-total" wx:if="{{!openingDish && form.photos.length && form.dishes}}"><text>{{form.photos.length}} {{form.photos.length === 1 ? 'dish' : 'dishes'}}</text><text>{{form.kcal === '' || form.kcal === null ? '—' : form.kcal}} kcal</text></view>
  </block>
  <view wx:if="{{analysisError}}" class="error" aria-live="polite">{{analysisError}}</view>
  <view wx:for="{{!openingDish && selectedDish.analysis ? [selectedDish] : []}}" wx:key="photo" class="card summary-dish-editor">
   <view class="dish-result-heading"><text class="dish-result-name">{{item.name || 'Dish'}}</text><button bindtap="editSelectedWeight" disabled="{{analyzing}}" aria-label="Edit dish weight and container">{{item.weight || 0}} g<image class="ui-icon" src="/assets/icons/pencil.svg"/></button></view>
   <template is="nutrition-editor" data="{{kcal:item.kcal,carbs:item.carbs,protein:item.protein,fat:item.fat,fiber:item.fiber,analyzing,analysisPhase,nutritionOpen,nutrients,ingredients:item.analysis.ingredients,correction,showRecalculate:!analysisDirty}}"/>
  </view>
  <view wx:if="{{form.mealAnalysis.text}}" class="card meal-analysis"><view class="card-heading"><text>Meal analysis</text></view><text class="meal-analysis-copy">{{form.mealAnalysis.text}}</text></view>
  <view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view>
</view></scroll-surface>
<dish-editor wx:if="{{dishEditor}}" record-id="{{dishEditor.id}}" photo-index="{{dishEditor.index}}" demo="{{preview}}" bindclose="dishEditorClosed"/>
</view>
