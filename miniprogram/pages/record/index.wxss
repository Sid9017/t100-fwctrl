.photo-strip { display:flex; gap:16rpx; margin:32rpx 0 24rpx; }.photo-slot { position:relative; width:calc((100% - 32rpx)/3); height:180rpx; border-radius:32rpx; background:#fff; flex:none; overflow:hidden; }.photo-slot image { width:100%; height:100%; }.add-photo { display:flex; flex-direction:column; gap:12rpx; border:1px dashed #b7bfa1; font-size:22rpx; padding:16rpx; }.add-photo > text:first-child { font-size:56rpx; font-weight:400; }.remove-photo { position:absolute; right:4rpx; top:4rpx; width:48px; min-height:48px; padding:0; background:#ffffffd9; font-size:40rpx; }.recognition-slot { display:flex; justify-content:space-between; padding:20rpx 24rpx; border:1px dashed #d1d8c3; border-radius:24rpx; color:#656b5f; font-size:24rpx; }.calorie-field input { font-size:44rpx; font-weight:700; }.ratings { display:flex; width:220px; max-width:74%; }.rating-button { flex:1; min-width:0; min-height:48px; padding:0; background:transparent; }.rating-button > view { width:22rpx; height:22rpx; border:2px solid #b0b895; border-radius:50%; }.rating-button.active > view { background:#9bbc00; border-color:#9bbc00; }.delete-meal { color:#aa4640!important; margin:24rpx auto; }.summary-photo { width:calc((100% - 32rpx)/3); height:150rpx; border-radius:28rpx; }.meal-summary .big-number { font-size:80rpx; }

.ratings { width:240px; max-width:none; }.rating-button { min-width:48px; }.add-photo .ui-icon { width:28px; height:28px; }
@media(max-width:350px){.card > .row { flex-direction:column; align-items:flex-start; }}

.nutrition-toggle { display:flex; justify-content:space-between; padding:0 0 20rpx; background:transparent; border-radius:0; font-size:28rpx; }.record-footer { position:fixed; left:0; right:0; bottom:0; z-index:20; padding:20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom)); background:#f9faf5; }.page-body { padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); }
