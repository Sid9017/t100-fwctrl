.meal-heading { position:relative; height:100rpx; margin:16rpx 0 24rpx; }
.meal-title { position:absolute; left:0; top:0; margin:0; opacity:0; transition:opacity 280ms ease; pointer-events:none; }
.meal-title.is-active { opacity:1; }
.photo-wheel { position:relative; width:100%; height:560rpx; max-width:622rpx; margin:12rpx auto 0; }
.wheel-sky { position:absolute; width:500rpx; height:500rpx; left:50%; top:30rpx; transform:translateX(-50%); border-radius:50%; overflow:hidden; }
.sky-fallback,.sky-animation { position:absolute; width:100%; height:100%; left:0; top:0; }
.sky-fallback { pointer-events:none; }
.rating-section { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:0 28rpx; margin:8rpx 0 24rpx; }
.rating-label { font-size:28rpx; color:#656b5f; }
.rating-row { display:flex; align-items:center; }
.meal-rating { width:76rpx; height:88rpx; min-width:44px; min-height:44px; padding:16rpx; background:transparent; }
.rating-dot { width:22rpx; height:22rpx; border:2px solid #b0b895; border-radius:50%; }.meal-rating.active .rating-dot { background:#9bbc00; border-color:#9bbc00; }
.photo-orbit { overflow:visible; position:absolute; width:540rpx; height:540rpx; left:50%; margin-left:-270rpx; top:10rpx; animation:meal-orbit 48s linear infinite; }
.orbit-slot { overflow:visible; position:absolute; width:112rpx; height:112rpx; margin:-56rpx 0 0 -56rpx; }
.slot-0 { left:50%; top:10%; }.slot-1 { left:88%; top:37.64%; }.slot-2 { left:73.51%; top:82.36%; }.slot-3 { left:26.49%; top:82.36%; }.slot-4 { left:12%; top:37.64%; }
.upright-photo { overflow:visible; position:relative; width:100%; height:100%; animation:meal-counter-orbit 48s linear infinite; }
.photo-item { position:relative; width:100%; height:100%; overflow:visible; opacity:1; transform:scale(1); transition:opacity 220ms ease,transform 220ms ease; }
.photo-item.is-removing { opacity:0; transform:scale(.55); pointer-events:none; }
.photo-frame { position:absolute; left:0; top:0; width:112rpx; height:112rpx; box-sizing:border-box; border:4rpx solid #fff; border-radius:50%; overflow:hidden; }
.is-selected .photo-frame { border:6rpx solid #99b900; }
.orbit-photo { display:block; width:100%; height:100%; }
.remove-photo { position:absolute; top:-24rpx; right:-24rpx; width:44px; height:44px; background:transparent; z-index:2; }
.remove-icon { position:absolute; right:8rpx; top:8rpx; width:32rpx; height:32rpx; padding:4rpx; border-radius:50%; background:#fff; }
.capture-button { position:absolute; top:280rpx; left:50%; transform:translate(-50%,-50%); width:152rpx; height:152rpx; min-height:64px; border-radius:50%; padding:0; background:#353535; z-index:2; }
.capture-icon { position:absolute; left:43rpx; top:43rpx; width:66rpx; height:66rpx; }.capture-button.is-disabled { background:#68734c; }
.is-paused .photo-orbit,.is-paused .upright-photo { animation-play-state:paused; }
@keyframes meal-orbit { to { transform:rotate(360deg); } } @keyframes meal-counter-orbit { to { transform:rotate(-360deg); } }
.meal-details { background:#fff; border-radius:36rpx; margin:8rpx 0 24rpx; padding:0 28rpx; }
.details-toggle { justify-content:space-between; padding:22rpx 0; background:transparent; font-size:28rpx; text-align:left; }
.details-arrow { width:24px; height:24px; transform:rotate(90deg); transition:transform 300ms ease; }.is-open .details-arrow { transform:rotate(-90deg); }
.details-reveal { max-height:0; opacity:0; overflow:hidden; transition:max-height 420ms cubic-bezier(.22,1,.36,1),opacity 260ms ease; }.is-open .details-reveal { max-height:480rpx; opacity:1; }
.details-content { padding-bottom:4rpx; }.description-input { width:100%; height:140rpx; padding:20rpx; border-radius:22rpx; background:#f7f7fa; color:#353535; font-size:28rpx; margin-bottom:24rpx; }.form-grid input { font-size:34rpx; }
.summary-photos { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:28rpx; }.summary-photo { width:calc((100% - 32rpx)/3); height:150rpx; border-radius:24rpx; }.meal-summary .big-number { font-size:80rpx; }
.delete-meal { color:#aa4640!important; margin:24rpx auto; }
.record-footer { position:fixed; left:0; right:0; bottom:0; z-index:20; padding:20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom)); background:#f9faf5; }.page-body { padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }.page-body.has-footer { padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); }
@media(prefers-reduced-motion:reduce){.photo-orbit,.upright-photo { animation:none; }.details-reveal,.details-arrow { transition:none; }}

.photo-orbit { pointer-events:none; }.orbit-slot.has-photo { pointer-events:auto; }
.wheel-sky { z-index:0; }.photo-orbit { z-index:1; }.capture-button { z-index:3; }

.capture-layer { position:absolute; left:50%; top:280rpx; width:152rpx; height:152rpx; transform:translate(-50%,-50%); z-index:10; }
.capture-layer .capture-button { position:relative; top:0; left:0; transform:none; }




@media(prefers-reduced-motion:reduce){.meal-title,.photo-item { transition:none; }}
