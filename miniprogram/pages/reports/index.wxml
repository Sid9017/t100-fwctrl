<view class="app-page theme-{{themeProfile}}" bindtap="collapseWeek"><scroll-surface snap-edges="{{true}}" snap-paused="{{!!modePhase || !!weekPhase || requestedRow >= 0}}" refresh-key="{{displayedModeIndex+':'+expandedRow+':'+weekPhase+':'+modePhase+':'+date+':'+month+':'+records.length}}"><view class="page-body"><view class="app-top main-top"><view class="wordmark brand-lockup"><scalebot class="brand-logo" demo="{{preview}}"/><text>KCALACK</text></view><picker-view class="report-mode-wheel" value="{{[reportModeIndex]}}" indicator-style="height:36rpx;background:transparent;border:0" indicator-class="report-wheel-indicator" mask-style="background:transparent" bindchange="changeReportMode" aria-label="{{'Statistics mode: '+reportModes[reportModeIndex].label}}"><picker-view-column><view class="report-mode-option" wx:for="{{reportModes}}" wx:key="id" aria-label="{{item.label}}"><image class="report-mode-title report-mode-{{item.id}}" src="{{'/assets/mode-'+item.id+'-color.png'}}" mode="aspectFit" aria-hidden="true"/></view></picker-view-column></picker-view></view><view class="report-content {{modePhase}}"><view class="preview-label" wx:if="{{preview}}">Devtools preview · sample records</view><text class="title">Your reports.</text>
  <block wx:if="{{displayedModeIndex === 0}}">
    <view class="card calendar-card">
      <view class="card-heading calendar-heading"><text>{{monthTitle}}</text><view class="month-navigation"><button class="round-button" data-delta="-1" catchtap="changeMonth" aria-label="Previous month">‹</button><button class="round-button" data-delta="1" catchtap="changeMonth" aria-label="Next month">›</button></view></view>
      <view class="calendar-grid weekdays"><text class="weekday" wx:for="{{weekdays}}" wx:key="id">{{item.label}}</text></view>
      <block wx:for="{{calendarRows}}" wx:key="id" wx:for-item="weekRow">
        <view class="calendar-grid calendar-week {{requestedRow === weekRow.id ? 'expanded-week' : ''}}" data-row="{{weekRow.id}}" catchtap="selectWeek">
          <block wx:for="{{weekRow.days}}" wx:key="id" wx:for-item="day">
            <view wx:if="{{day.blank}}" class="calendar-blank"/>
            <button wx:else class="calendar-day {{day.selected ? 'selected' : ''}} {{day.today ? 'is-today' : ''}} {{day.future ? 'future' : ''}}" data-date="{{day.date}}" data-row="{{weekRow.id}}" catchtap="selectCalendarDay" aria-disabled="{{day.future}}" aria-pressed="{{day.selected}}" aria-expanded="{{requestedRow === weekRow.id}}" aria-label="{{day.date+', '+day.recordCount+' meals'+(day.future ? ', future date' : ', show week statistics')}}" hover-class="none"><image class="day-calorie-ring" src="{{day.preview}}" aria-hidden="true"/><text class="calendar-number">{{day.day}}</text></button>
          </block>
        </view>
        <view wx:if="{{expandedRow === weekRow.id}}" class="week-detail {{weekPhase}}" style="{{'height:'+weekHeight+';'}}" catchtap="noop">
          <view class="week-detail-content">
            <view class="week-chart">
              <view class="chart-grid" aria-hidden="true"><view wx:for="{{week.axis}}" wx:key="value" class="chart-gridline" style="{{'bottom:'+item.position+'%;'}}"><text class="chart-axis-label">{{item.value}}</text></view></view>
              <button wx:for="{{week.days}}" wx:key="date" hover-class="none" class="chart-column {{item.date === date ? 'selected' : ''}} {{item.future ? 'future' : ''}}" data-date="{{item.date}}" catchtap="selectDay" aria-disabled="{{item.future}}" aria-label="{{item.date+', target '+(item.target === null ? 'unavailable' : item.target+' kcal')+', actual '+item.consumed+' kcal'}}"><view class="bar-space"><view wx:if="{{item.targetHeight !== null}}" class="chart-bar chart-target" style="{{'height:'+item.targetHeight+'%;'}}"/><view class="chart-bar chart-actual" style="{{'height:'+item.height+'%;'}}"/></view><text class="chart-date">{{item.day}}</text></button>
            </view>
          </view>
        </view>
      </block>
      <view class="month-summary {{expandedRow >= 0 ? 'is-collapsed' : ''}}" aria-hidden="{{expandedRow >= 0}}"><view class="month-summary-inner"><view><text class="month-average">{{monthStats.average || 0}}</text><text class="number-unit">KCAL / DAY</text></view></view></view>
    </view>
<view class="card daily-report" capture-bind:tap="collapseWeek"><view class="card-heading"><text>Daily report</text><text class="muted">{{date === today ? 'Today' : date}}</text></view><view class="big-number">{{summary.consumed}}<text class="number-unit">KCAL</text></view><text class="subtitle">{{summary.recordCount}} meals recorded</text><view class="progress report-progress"><view style="{{'width:'+summary.progress+'%;'}}"/></view><view class="row"><text class="muted">{{summary.target === null ? 'No plan for this day' : 'Target '+summary.target}}</text><text class="muted" wx:if="{{summary.target !== null}}">{{summary.remaining >= 0 ? summary.remaining+' remaining' : -summary.remaining+' above target'}}</text></view><nutrition-rings wx:if="{{summary}}" nutrients="{{summary.nutrients}}"/></view><view class="card"><text class="card-heading">The day’s meals</text><button class="meal-row" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="editMeal"><image class="meal-photo" wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill"/><view class="meal-info"><text class="meal-meta">{{item.mealLabel}} · {{item.timeLabel}}</text><text class="meal-name">{{item.name}}</text><text class="meal-kcal">{{item.kcal === null ? '—' : item.kcal}}<text class="number-unit">KCAL</text></text></view><text class="chevron">›</text></button><view wx:if="{{!records.length}}" class="empty"><text>No records for this day.</text></view></view>
  </block><view wx:else class="empty report-unavailable"><text>Reports coming soon.</text></view></view></view></scroll-surface></view>
