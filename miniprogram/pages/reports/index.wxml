<view class="app-page theme-{{themeProfile}}"><scroll-surface snap-edges="{{true}}" snap-paused="{{!!modePhase || !!periodPhase}}" refresh-key="{{displayedModeIndex+':'+renderedView+':'+periodPhase+':'+modePhase+':'+date+':'+month+':'+records.length}}"><view class="page-body"><view class="app-top"><view class="wordmark brand-lockup"><image class="brand-logo" src="/assets/ui/kcalbot.svg" mode="aspectFit" aria-hidden="true"/><text>KCALACK</text></view><picker-view class="report-mode-wheel" value="{{[reportModeIndex]}}" indicator-style="height:36rpx;background:transparent;border:0" indicator-class="report-wheel-indicator" mask-style="background:transparent" bindchange="changeReportMode" aria-label="{{'Statistics mode: '+reportModes[reportModeIndex].label}}"><picker-view-column><view class="report-mode-option" wx:for="{{reportModes}}" wx:key="id" aria-label="{{item.label}}"><image class="report-mode-title report-mode-{{item.id}}" src="{{'/assets/mode-'+item.id+'-color.png'}}" mode="aspectFit" aria-hidden="true"/></view></picker-view-column></picker-view></view><view class="report-content {{modePhase}}"><view class="preview-label" wx:if="{{preview}}">Devtools preview · sample records</view><text class="title">Your reports.</text>
  <block wx:if="{{displayedModeIndex === 0}}"><view class="segments {{view === 'month' ? 'month-selected' : ''}}"><button class="{{view === 'week' ? 'active' : ''}}" aria-pressed="{{view === 'week'}}" data-view="week" bindtap="view">Week</button><button class="{{view === 'month' ? 'active' : ''}}" aria-pressed="{{view === 'month'}}" data-view="month" bindtap="view">Month</button></view>
  <view class="period-transition {{periodPhase}}" style="{{'height:'+periodHeight+';'}}"><view class="period-content"><block wx:if="{{renderedView === 'week'}}"><view class="card"><text class="card-heading">The last seven days</text><view class="big-number">{{week.average === null ? '—' : week.average}}<text class="number-unit">KCAL / DAY</text></view><text class="subtitle">{{week.recordedDays}} recorded {{week.recordedDays === 1 ? 'day' : 'days'}}</text><view class="week-chart"><button wx:for="{{week.days}}" wx:key="date" class="chart-column {{item.date === date ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDay" aria-label="{{item.date}}, {{item.recordCount ? item.consumed+' kcal recorded' : 'No records'}}"><view class="bar-space"><view class="chart-bar {{item.tone}}" style="{{'height:'+item.height+'%;'}}"/><view wx:if="{{item.targetHeight !== null}}" class="target-tick" style="{{'bottom:'+item.targetHeight+'%;'}}"/></view><text>{{item.label}}</text><text class="muted">{{item.day}}</text></button></view><view class="chart-legend"><view class="legend-lime"/><text>Recorded calories</text><view class="legend-line"/><text>Daily target</text></view><view class="week-totals"><view class="row"><text class="muted">Days with records</text><text>{{week.recordedDays}} / 7</text></view><view class="row"><text class="muted">Recorded total</text><text>{{week.total}} kcal</text></view></view></view></block>
  <block wx:else><view class="card calendar-card"><view class="card-heading"><button class="round-button" data-delta="-1" bindtap="changeMonth" aria-label="Previous month">‹</button><text>{{monthTitle}}</text><button class="round-button" data-delta="1" bindtap="changeMonth" aria-label="Next month">›</button></view><view class="calendar-grid"><text class="weekday" wx:for="{{weekdays}}" wx:key="id">{{item.label}}</text><button class="calendar-day {{item.selected ? 'selected' : ''}} {{item.future ? 'future' : ''}}" wx:for="{{calendar}}" wx:key="id" disabled="{{item.blank || item.future}}" data-date="{{item.date}}" bindtap="selectDay"><text>{{item.blank ? '' : item.day}}</text><view wx:if="{{item.recorded}}" class="calendar-dot {{item.tone}}"/></button></view><view class="calendar-legend"><text>Within target</text><text>Above target</text><text>Above TDEE</text></view></view></block>
</view></view><view class="card daily-report"><view class="card-heading"><text>Daily report</text><text class="muted">{{date === today ? 'Today' : date}}</text></view><view class="big-number">{{summary.consumed}}<text class="number-unit">KCAL</text></view><text class="subtitle">{{summary.recordCount}} meals recorded</text><view class="progress report-progress"><view style="{{'width:'+summary.progress+'%;'}}"/></view><view class="row"><text class="muted">{{summary.target === null ? 'No plan for this day' : 'Target '+summary.target}}</text><text class="muted" wx:if="{{summary.target !== null}}">{{summary.remaining >= 0 ? summary.remaining+' remaining' : -summary.remaining+' above target'}}</text></view><view class="nutrients"><view class="nutrient" wx:for="{{summary.nutrients}}" wx:key="key"><text class="muted">{{item.label}}</text><view class="progress"><view class="{{item.key}}" style="{{'width:'+item.progress+'%;'}}"/></view><text class="nutrient-value">{{item.total}} g</text><text class="muted">{{item.goal === null ? 'No target' : 'of '+item.goal+' g'}}{{item.partial ? ' · partial' : ''}}</text></view></view></view><view class="card"><text class="card-heading">The day’s meals</text><button class="meal-row" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="editMeal"><image class="meal-photo" wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill"/><view class="meal-info"><text class="meal-meta">{{item.mealLabel}} · {{item.timeLabel}}</text><text class="meal-name">{{item.name}}</text><text class="meal-kcal">{{item.kcal === null ? '—' : item.kcal}}<text class="number-unit">KCAL</text></text></view><text class="chevron">›</text></button><view wx:if="{{!records.length}}" class="empty"><text>No records for this day.</text></view></view>
</block><view wx:else class="empty report-unavailable"><text>Reports coming soon.</text></view></view></view></scroll-surface></view>
