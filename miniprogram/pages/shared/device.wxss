.settings-update { margin-bottom:24rpx; }.presence-dot { width:12rpx; height:12rpx; border-radius:50%; background:#a5aa9e; }.presence-dot.nearby { background:#93b900; }

.weighing-reading { margin:20rpx 0 0; text-align:right; }.weighing-reading .big-number { margin:16rpx 0 28rpx; font-size:100rpx; }.weighing-reading .row { border-top:1px solid #e1e8cf; padding-top:20rpx; }.weighing-reading .number-unit { font-size:36rpx; }.field + .field { margin-top:20rpx; }

.add-method-sheet { position:absolute; left:0; right:0; bottom:0; max-width:540px; margin:auto; border-radius:48rpx 48rpx 0 0; background:#f9faf5; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }.add-method-content { padding:0 32rpx; }.add-method { text-align:left; justify-content:space-between; padding:32rpx; border-radius:32rpx; background:#fff; margin-top:20rpx; gap:20rpx; }.add-method > view { min-width:0; }.add-method .muted { font-weight:400; margin-top:12rpx; }.scan-target { display:block; padding:0 32rpx 24rpx; font-size:28rpx; font-weight:650; }.remove-device { margin-top:24rpx; }

.container-strip { display:flex; gap:16rpx; margin:20rpx 0; }.container-strip > .secondary { flex:1; min-width:0; justify-content:space-between; }.add-method > view { display:flex; align-items:center; gap:20rpx; }.rating-dots { width:240px; max-width:none; }.rating-dot { min-width:48px; }.shell .title { font-size:52rpx; }.connect-intro { padding:16rpx 0 24rpx; }.weighing-reading .big-number { overflow-wrap:anywhere; }
@media(max-width:350px){.rating-row { align-items:flex-start; flex-direction:column; }}

.device-footer { flex:none; padding:20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom)); background:rgba(249,250,245,.94); }.mode-picker { height:108rpx; }.unit-picker { height:108rpx; }.mode-option,.unit-option { height:36rpx; }.mode-option image { height:24rpx; }.mode-controls { margin-bottom:0; }.display-caption { margin-bottom:12rpx; }.quick-controls { margin-top:12rpx; margin-bottom:16rpx; }

/* The physical scale owns mode selection; tint follows confirmed FEE1/FEE5. */
.shell.profile-3 { background:linear-gradient(180deg,#ffffff 0%,#f6faec 42%,#ddebab 100%); }
.shell.profile-0 { background:linear-gradient(180deg,#ffffff 0%,#fffbee 42%,#f8e3a6 100%); }
.shell.profile-1 { background:linear-gradient(180deg,#ffffff 0%,#faf3ed 42%,#e5c5b0 100%); }
.shell.profile-2 { background:linear-gradient(180deg,#ffffff 0%,#fff5e9 42%,#f7d1a6 100%); }
.mode-readonly { width:230rpx; height:40rpx; flex:1; }.mode-controls { min-height:88rpx; }

.screen-content,.scanner-content { padding-right:48rpx; }
