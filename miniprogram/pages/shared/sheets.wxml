  <view class="scanner-overlay" wx:if="{{showScanner}}">
    <view class="scanner-mask" bindtap="closeScanner" catchtouchmove="noop"/>
    <view class="scanner-sheet" role="dialog" aria-label="Add a KCALACK device">
      <view class="scanner-header"><view><text class="eyebrow">ADD DEVICE</text><text class="sheet-title">{{scanSource === 'barcode' ? 'Finding your device.' : 'Nearby devices.'}}</text></view><button class="sheet-close" aria-label="Close device list" disabled="{{connecting}}" bindtap="closeScanner"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view>
      <view class="scanner-status"><view class="presence-dot {{scanning ? 'scanning' : ''}}"/><text>{{connecting ? 'Connecting…' : scanning ? 'Scanning…' : 'Scan complete'}}</text></view>
      <scroll-surface class="scanner-results" refresh-key="{{newNearbyDevices.length+':'+connecting+':'+error}}"><view class="scanner-content">
        <button class="device-item" wx:for="{{newNearbyDevices}}" wx:key="id" data-id="{{item.id}}" bindtap="connect" aria-label="{{'Add '+item.name}}" disabled="{{connecting || working || bridgeOnly}}"><text class="device-name">{{item.name}}</text><image class="ui-icon" src="/assets/icons/plus.svg" aria-hidden="true"/></button>
        <view class="error" wx:if="{{error}}">{{error}}</view>
        <view class="warning" wx:if="{{scanStats.cacheError}}">{{scanStats.cacheError}}</view>
      </view></scroll-surface>
      <view class="scanner-footer"><button class="primary" disabled="{{connecting}}" loading="{{scanning}}" bindtap="scan">{{scanning ? 'Stop scanning' : 'Scan again'}}</button></view>
    </view>
  </view>
  <view class="scanner-overlay" wx:if="{{showSettings}}"><view class="scanner-mask" bindtap="closeSettings" catchtouchmove="noop"/><view class="scanner-sheet settings-sheet"><view class="scanner-header"><view><text class="eyebrow">YOUR DEVICE</text><text class="sheet-title">Device settings.</text></view><button class="sheet-close" aria-label="Close settings" bindtap="closeSettings"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view><scroll-surface class="scanner-results" refresh-key="{{showTools+':'+showFirmwareDetails+':'+showPrevious+':'+showOtherDevices+':'+newNearbyDevices.length+':'+activity.length+':'+containerLibrary.length+':'+connected+':'+error+':'+feedback}}"><view class="scanner-content">
    <view class="operation-card" wx:if="{{hasKnownDevices}}"><text class="card-title">Your device</text><text class="muted">{{knownDeviceRows[0].name}}</text><button class="danger-button remove-device" disabled="{{busy || working}}" bindtap="removeSavedDevice"><image class="ui-icon" aria-hidden="true" src="/assets/icons/trash.svg"/><text>Remove</text></button></view><button class="secondary settings-update" bindtap="openFirmware"><image class="ui-icon" aria-hidden="true" src="/assets/icons/download.svg"/><text>Firmware</text></button><view class="settings-device" wx:if="{{connected}}"><text class="device-name">{{deviceName}}</text><view class="settings-metrics"><text>{{bindingText}}</text><text>{{firmware}}</text><text>{{batteryText}}</text></view><view class="split-actions"><button class="secondary" disabled="{{working || busy}}" aria-label="Refresh device status" bindtap="refresh"><image class="ui-icon" aria-hidden="true" src="/assets/icons/refresh.svg"/></button><button class="secondary" disabled="{{working || busy}}" bindtap="disconnect">Disconnect</button></view><button class="primary" data-action="bindDevice" disabled="{{working || busy || (bound && !hasAuth)}}" bindtap="command">{{bound ? 'Reinstall emotion pack' : 'Bind + install emotion'}}</button></view>
    <view class="operation-card auth-card"><view class="section-heading"><text>Auth backup</text><text class="small-state">{{authCount}} saved</text></view><view class="split-actions"><button class="secondary" disabled="{{working || busy}}" bindtap="importAuthFile"><image class="ui-icon" aria-hidden="true" src="/assets/icons/upload.svg"/><text>Import</text></button><button class="secondary" disabled="{{working || busy || !authCount}}" bindtap="exportAuth"><image class="ui-icon" aria-hidden="true" src="/assets/icons/download.svg"/><text>Export</text></button></view><textarea class="auth-text" placeholder="Paste an auth object or array" placeholder-style="color:#6b7064" value="{{authJson}}" maxlength="1048576" disabled="{{working || busy}}" bindinput="onAuthText"/><button class="primary" disabled="{{working || busy || !authJson}}" bindtap="importAuthText">Import JSON</button><button class="secondary" wx:if="{{authExportPath}}" bindtap="shareAuth">Share backup JSON</button></view>
    <view class="operation-card" wx:if="{{connected}}"><view class="section-heading"><text>Reset device</text></view><text class="muted">Reset clears binding and device data. Factory reset also erases its identity.</text><view class="split-actions"><button class="danger-button" disabled="{{!hasAuth || busy || working}}" bindtap="resetDevice">Reset</button><button class="danger-button" disabled="{{busy || working}}" bindtap="factoryDevice">Factory reset</button></view></view>
    <view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view>
  </view></scroll-surface></view></view>
  <view class="scanner-overlay" wx:if="{{showActivity}}"><view class="scanner-mask" bindtap="toggleActivity" catchtouchmove="noop"/><view class="scanner-sheet"><view class="scanner-header"><view><text class="eyebrow">DEVICE ACTIVITY</text><text class="sheet-title">What’s happening.</text></view><button class="sheet-close" aria-label="Close activity" bindtap="toggleActivity"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view><scroll-surface class="scanner-results" refresh-key="{{showTools+':'+showFirmwareDetails+':'+showPrevious+':'+showOtherDevices+':'+newNearbyDevices.length+':'+activity.length+':'+containerLibrary.length+':'+connected+':'+error+':'+feedback}}"><view class="scanner-content"><view wx:if="{{!activity.length}}" class="scan-empty">No activity yet.</view><view class="log-row" wx:for="{{activity}}" wx:key="index"><text>{{item.time}}</text><text selectable>{{item.line}}</text></view></view></scroll-surface><view class="scanner-footer"><button class="secondary" bindtap="clearActivity">Clear activity</button></view></view></view>

<view class="scanner-overlay" wx:if="{{showAddDevice}}"><view class="scanner-mask" bindtap="closeAddDevice"/><view class="add-method-sheet"><view class="scanner-header"><view><text class="sheet-title">Add device.</text></view><button class="sheet-close" aria-label="Close add device" bindtap="closeAddDevice"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view><view class="add-method-content"><button class="add-method" bindtap="scanBarcode"><view><image class="ui-icon" aria-hidden="true" src="/assets/icons/scan.svg"/><text>Scan barcode</text></view><image class="ui-icon" aria-hidden="true" src="/assets/icons/arrow-right.svg"/></button><button class="add-method" bindtap="openScanner"><view><image class="ui-icon" aria-hidden="true" src="/assets/icons/bluetooth.svg"/><text>Nearby devices</text></view><image class="ui-icon" aria-hidden="true" src="/assets/icons/arrow-right.svg"/></button></view></view></view>
