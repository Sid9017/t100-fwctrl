<view class="live-device">
  <view class="live-scene {{compact ? 'is-compact' : ''}}"><view class="live-stage {{compact ? 'is-compact' : ''}}">
    <image wx:if="{{!animating}}" class="live-chassis {{displayReady ? 'is-faded' : ''}}" src="/pairing/assets/final.svg" mode="aspectFit"/>
    <canvas wx:if="{{animating}}" type="2d" id="pairing" class="live-chassis"/>
    <view class="live-display {{displayReady ? 'is-ready' : ''}}" style="{{frameStyle}}"><device-preview wx:if="{{!animating && !showControls && !showSettings && !showActivity && !showContainers}}" display-only connected="{{connected}}" fade-ms="{{crossFading ? 420 : 0}}" active="{{active && !animating && !showControls && !showSettings && !showActivity && !showContainers}}" status="{{status}}" reading="{{reading}}" commits="{{previewCommits}}"/></view>
  </view></view>
  <button wx:if="{{profile === 3}}" class="container-entry" disabled="{{!canControl || working}}" bindtap="openContainers"><text>{{containerState ? 'Container · '+containerState.mg/1000+' g' : 'Set container weight'}}</text><image class="ui-icon" src="/assets/icons/plus.svg" aria-hidden="true"/></button>
</view>
<view class="scanner-overlay" wx:if="{{showControls}}"><view class="scanner-mask" bindtap="closeControls" catchtouchmove="noop"/><view class="scanner-sheet"><view class="scanner-header"><text class="sheet-title">Device controls.</text><button class="sheet-close" aria-label="Close controls" bindtap="closeControls"><image class="ui-icon" src="/assets/icons/x.svg"/></button></view>
<scroll-surface class="scanner-results" refresh-key="{{showTools+':'+containerMessage+':'+feedback+':'+error}}"><view class="scanner-content">
<view class="controls-heading"><text>{{deviceName}}</text><button class="live-action" aria-label="Device settings" bindtap="openSettings"><image class="ui-icon" src="/assets/icons/settings.svg"/></button></view>
<view class="preview-banner" wx:if="{{preview}}"><picker range="{{previewScenes}}" value="{{sceneIndex}}" bindchange="onScene"><view>{{previewScenes[sceneIndex]}} ▾</view></picker></view>
        <view class="binding-card" wx:if="{{bound && !hasAuth}}"><text class="muted">Restore this device’s auth backup to use its controls.</text><button class="secondary" bindtap="openSettings">Import auth</button></view>
        <view class="operation-card" wx:if="{{profile === 1 || profile === 2}}"><view class="section-heading"><text>{{profile === 1 ? 'Espresso recipe' : 'PourOver recipe'}}</text><text class="small-state">{{coffeeStage}}</text></view><view class="form-grid two"><view class="field"><text>{{profile === 1 ? 'Coffee liquid · g' : 'Coffee grounds · g'}}</text><input type="digit" data-field="base" value="{{form.base}}" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="field"><text>Water ratio · 1 : x</text><input type="digit" data-field="ratio" value="{{form.ratio}}" disabled="{{!canControl || working}}" bindinput="onField"/></view></view><view class="recipe-result"><view><text class="muted">Coffee</text><text>{{recipePrimary}} g</text></view><view class="ratio-link">:</view><view><text class="muted">Water</text><text>{{recipeWater}} g</text></view></view><view class="recipe-progress"><view><view style="{{'width:'+ primaryProgress +'%;'}}"/></view><view><view style="{{'width:'+ waterProgress +'%;'}}"/></view></view><view class="split-actions"><button class="secondary" disabled="{{!canControl || working}}" bindtap="clearRecipe">Clear recipe</button><button class="primary" disabled="{{!canControl || working}}" bindtap="applyRecipe">Apply recipe</button></view></view>
        <button class="text-button" bindtap="toggleTools">{{showTools ? '▾' : '▸'}} More device controls</button><view wx:if="{{showTools}}"><view class="operation-card"><view class="section-heading"><text>Countdown</text><button class="text-button" disabled="{{!canControl || working}}" bindtap="syncToday">Use today’s plan</button><text class="small-state">kcal</text></view><view class="form-grid three"><view class="field"><text>Remaining</text><input type="text" data-field="current" value="{{form.current}}" placeholder="Can be negative" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="field"><text>Target</text><input type="number" data-field="target" value="{{form.target}}" placeholder="Target" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="field"><text>TDEE</text><input type="number" data-field="tdee" value="{{form.tdee}}" placeholder="TDEE" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view></view><button class="primary" disabled="{{!canControl || working}}" bindtap="updateCountdown">Update countdown</button></view>
        <view class="operation-card"><view class="section-heading"><text>Notify bubble</text><view class="color-dot" style="{{'background:'+ form.color +';'}}"/></view><view class="field"><text>Message</text><input data-field="notify" value="{{form.notify}}" maxlength="40" placeholder="A little reminder" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="color-swatches"><button wx:for="{{notifyColors}}" wx:key="*this" class="color-swatch {{form.color === item ? 'selected' : ''}}" data-color="{{item}}" aria-label="Notify color {{item}}" bindtap="chooseColor"><view style="{{'background:'+ item +';'}}"/></button></view><view class="notify-actions"><view class="field color-field"><text>Color · hex</text><input data-field="color" value="{{form.color}}" maxlength="7" disabled="{{!canControl || working}}" bindinput="onField"/></view><button class="primary" disabled="{{!canControl || working}}" bindtap="showNotify">Show notify</button></view></view>
        <view class="operation-card history-card"><view class="section-heading"><text>Kcal history</text><text class="small-state">Up to 3 images</text></view><picker-view class="food-picker" value="{{photos}}" indicator-style="height:64rpx;border:0;background:#ebefdf66;border-radius:14rpx" mask-class="food-mask" bindchange="onPhotos"><picker-view-column wx:for="{{[0,1,2]}}" wx:key="*this" wx:for-item="column"><view class="food-option" wx:for="{{foodItems}}" wx:key="file" aria-label="{{item.label}}"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit"/><text wx:else>No image</text></view></picker-view-column></picker-view><view class="form-grid history-fields"><view class="field"><text>Kcal</text><input type="number" data-field="kcal" value="{{form.kcal}}" placeholder="kcal" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="field"><text>Weight</text><input type="digit" data-field="historyWeight" value="{{form.historyWeight}}" placeholder="Weight" placeholder-style="color:#6b7064" disabled="{{!canControl || working}}" bindinput="onField"/></view><view class="field"><text>Unit</text><picker-view class="history-unit-picker" value="{{[form.historyUnit]}}" indicator-style="height:36rpx;border:0" mask-class="wheel-mask" bindchange="onHistoryUnit"><picker-view-column><view class="unit-option">g</view><view class="unit-option">oz</view></picker-view-column></picker-view></view></view><view class="rating-row"><text class="muted">Rating</text><view id="rating" class="rating-dots" catchtouchstart="onRatingStart" catchtouchmove="onRatingMove"><button wx:for="{{ratingDots}}" wx:key="*this" class="rating-dot {{item <= rating ? 'filled' : ''}}" data-value="{{item}}" aria-label="{{item}} out of 5" bindtap="setRating" disabled="{{working || busy}}"><view/></button></view></view><button class="primary" disabled="{{!canControl || working}}" bindtap="appendHistory">Append kcal</button></view>
        </view><view class="feedback" wx:if="{{feedback}}">{{feedback}}</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="warning" wx:for="{{warnings}}" wx:key="*this">{{item}}</view>
        <button class="activity-toggle" bindtap="toggleActivity">Activity {{activity.length ? '· '+activity.length : ''}}</button>


<view class="inline-record"><button wx:if="{{bound}}" class="primary" disabled="{{!canControl || working}}" bindtap="recordMeal"><image class="ui-icon" aria-hidden="true" src="/assets/icons/camera-light.svg"/><text>Record meal</text></button><button wx:else class="primary" data-action="bindDevice" disabled="{{working || busy || !status}}" bindtap="command">Bind device</button></view></view></scroll-surface></view></view>
<include src="../../pages/shared/sheets.wxml"/><view class="scanner-overlay" wx:if="{{showContainers}}"><view class="scanner-mask" bindtap="closeContainers"/><view class="scanner-sheet"><view class="scanner-header"><view><text class="eyebrow">CONTAINERS</text><text class="sheet-title">Containers.</text></view><button class="sheet-close" aria-label="Close containers" bindtap="closeContainers"><image class="ui-icon" aria-hidden="true" src="/assets/icons/x.svg"/></button></view><scroll-surface class="scanner-results" refresh-key="{{showTools+':'+showFirmwareDetails+':'+showPrevious+':'+showOtherDevices+':'+newNearbyDevices.length+':'+activity.length+':'+containerLibrary.length+':'+connected+':'+error+':'+feedback}}"><view class="scanner-content"><button class="device-item" wx:for="{{containerLibrary}}" wx:key="id" data-id="{{item.id}}" bindtap="useContainer" disabled="{{working || !canControl}}"><text>{{item.name}}</text><text>{{item.grams}} g</text></button><view class="operation-card"><text class="card-title">New container</text><label class="field">Name<input maxlength="40" value="{{containerName}}" bindinput="onContainerName" placeholder="My breakfast bowl" placeholder-style="color:#6b7064"/></label><label class="field">Weight · g<input type="digit" value="{{form.container}}" data-field="container" bindinput="onField"/></label><button class="primary" disabled="{{working || !canControl}}" bindtap="saveContainer">Save container</button><button class="text-button" wx:if="{{containerState}}" disabled="{{working || !canControl}}" bindtap="clearContainer">Clear container</button></view></view></scroll-surface></view></view>
