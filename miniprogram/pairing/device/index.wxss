@import "../../pages/shared/device.wxss";
:host { display:block; width:100%; }.live-device { width:100%; margin:0 0 24rpx; }.live-toolbar { display:flex; align-items:center; justify-content:space-between; height:60rpx; }.live-mode { width:240rpx; height:42rpx; }.live-action { display:flex; align-items:center; justify-content:center; width:48px; height:48px; padding:12px; background:transparent; border:0; border-radius:50%; }.live-action::after { border:0; }.live-action .ui-icon { width:24px; height:24px; }
.live-scene { position:relative; width:100%; height:0; padding-bottom:76.470588%; overflow:hidden; }.live-chassis { position:absolute; inset:0; width:100%; height:100%; }.live-display { position:absolute; opacity:0; transition:opacity 350ms ease; }.live-display.is-ready { opacity:1; }.live-caption { display:flex; justify-content:space-between; color:#6b7064; font-size:20rpx; letter-spacing:1rpx; margin-top:-12rpx; }.controls-heading { display:flex; justify-content:space-between; align-items:center; font-size:24rpx; color:#6b7064; }.inline-record { padding:20rpx 0; }.scanner-sheet { animation:sheet-enter 220ms ease-out; }.scanner-mask { animation:mask-enter 180ms ease-out; }
@keyframes sheet-enter { from { transform:translateY(100%); } to { transform:translateY(0); } }@keyframes mask-enter { from { opacity:0; } to { opacity:1; } }
@media(prefers-reduced-motion:reduce){.scanner-sheet,.scanner-mask { animation:none; }.live-display { transition:none; }}

.container-entry { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:48px; margin:12rpx 0 20rpx; padding:16rpx 24rpx; background:#ffffffb8; border-radius:999rpx; color:#535e36; font-size:26rpx; }.container-entry .ui-icon { width:20px; height:20px; }.container-entry::after { border:0; }

.live-scene { transition:padding-bottom 650ms cubic-bezier(.22,.68,0,1); }.live-scene.is-compact { padding-bottom:25%; }.live-stage { position:absolute; top:0; left:0; width:100%; height:0; padding-bottom:76.470588%; transition:transform 650ms cubic-bezier(.22,.68,0,1); }.live-stage.is-compact { transform:translateY(-62%); }.live-chassis { opacity:1; transition:opacity 420ms ease; }.live-chassis.is-faded { opacity:0; }.live-display { transition:opacity 420ms ease; }.live-device { margin-bottom:16rpx; }@media(prefers-reduced-motion:reduce){.live-scene,.live-stage,.live-chassis,.live-display { transition:none; }}

