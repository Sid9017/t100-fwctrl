{
  "name": "t100-fwctrl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T100 browser manufacturing console",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:miniprogram": "node scripts/build-miniprogram.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.js src/vendor/ble/core/*.test.js src/vendor/ble/protocol/*.test.js src/vendor/ble/morph_theme/*.test.js src/vendor/ble/session/*.test.js",
    "test:browser": "playwright test",
    "dev:ble": "python3 scripts/desktop-ble/bridge.py"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2"
  }
}
